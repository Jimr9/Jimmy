<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WSJTX_Controller.SupportReportWindow"
        Title="Create Support Report"
        Width="500" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="12">
        <TextBlock Text="Callsign (optional)" Margin="0,0,0,4"/>
        <TextBox x:Name="CallsignBox" AutomationProperties.Name="Callsign" CharacterCasing="Upper" Margin="0,0,0,10"/>

        <TextBlock Text="Name (optional)" Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox" AutomationProperties.Name="Name" Margin="0,0,0,10"/>

        <TextBlock Text="Email address (optional)" Margin="0,0,0,4"/>
        <TextBox x:Name="EmailBox" AutomationProperties.Name="Email address" Margin="0,0,0,10"/>

        <TextBlock Text="Problem type" Margin="0,0,0,4"/>
        <ComboBox x:Name="ProblemTypeCombo" AutomationProperties.Name="Problem type" Margin="0,0,0,10">
            <ComboBoxItem Content="Bug / Problem"/>
            <ComboBoxItem Content="Feature Request"/>
            <ComboBoxItem Content="Accessibility"/>
            <ComboBoxItem Content="Question / Other"/>
        </ComboBox>

        <TextBlock Text="Problem description (required)" Margin="0,0,0,4"/>
        <TextBlock Text="Describe what you were doing, what you expected to happen, and what actually happened."
                   Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBox x:Name="DescBox" AutomationProperties.Name="Problem description" Height="80" Margin="0,0,0,10"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

        <TextBlock Text="Steps to reproduce (optional)" Margin="0,0,0,4"/>
        <TextBlock Text="If someone else wanted to reproduce this problem, what steps should they follow?"
                   Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBox x:Name="StepsBox" AutomationProperties.Name="Steps to reproduce" Height="80" Margin="0,0,0,10"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="OkButton" Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
