<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WSJTX_Controller.HelpWindow"
        Title="Jimmy Test Help"
        Width="620" Height="600" WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="SupportReportButton" Content="Create _Support Report..." Padding="8,4" Margin="0,0,8,0"
                    Click="SupportReportButton_Click"/>
            <Button x:Name="CloseButton" Content="Close" Padding="8,4" IsCancel="True" Click="CloseButton_Click"/>
        </StackPanel>
        <TextBox x:Name="HelpTextBox" AutomationProperties.Name="Shortcut key help" IsReadOnly="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
    </DockPanel>
</Window>
