<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WSJTX_Controller"
        x:Class="WSJTX_Controller.EditLogRowOrderWindow"
        Title="Edit Log Row Order"
        Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock Text="Choose which columns to show, and their order:" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <local:CheckableOrderedListBox x:Name="FieldList"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OkButton" Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
