<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WSJTX_Controller"
        x:Class="WSJTX_Controller.SortOrderWindow"
        Title="Stations Available Sort Order"
        Width="520" Height="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OkButton" Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>

        <TabControl x:Name="Tabs">
            <TabItem Header="Priorities &amp; Filters" AutomationProperties.Name="Priorities and Filters">
                <StackPanel Margin="10">
                    <TextBlock Text="Checked categories are prioritized in list order (top = highest priority); this same order also drives Alt+N cycling. Unchecked categories are still shown but ranked as ordinary."
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <local:CheckableOrderedListBox x:Name="CallingList"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Normal Sort Order" AutomationProperties.Name="Normal Sort Order">
                <StackPanel Margin="10">
                    <TextBlock Text="Checked sort methods (applied in list order) rank ordinary calls among themselves." TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <local:CheckableOrderedListBox x:Name="SortList"/>
                    <TextBlock Text="Beam heading preference:" Margin="0,10,0,4"/>
                    <ComboBox x:Name="BeamCombo" AutomationProperties.Name="Beam heading preference"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
