<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WSJTX_Controller.CheckableOrderedListBox">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ListBox x:Name="ListBox" Grid.Column="0" MinHeight="140"
                 PreviewKeyDown="ListBox_PreviewKeyDown"
                 SelectionChanged="ListBox_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayText}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Top">
            <Button x:Name="MoveUpButton" Content="Move _Up" Width="90" Margin="0,0,0,4" Padding="4"
                    Click="MoveUpButton_Click"/>
            <Button x:Name="MoveDownButton" Content="Move _Down" Width="90" Margin="0,0,0,4" Padding="4"
                    Click="MoveDownButton_Click"/>
            <Button x:Name="RestoreDefaultsButton" Content="Restore _Defaults" Width="90" Padding="4"
                    Click="RestoreDefaultsButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
