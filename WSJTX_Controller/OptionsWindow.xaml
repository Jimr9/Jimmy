<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WSJTX_Controller.OptionsWindow"
        Title="Jimmy Test Options"
        Width="640" Height="520" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OkButton" Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>

        <!-- Category-list + detail-panel navigation, matching the current WinForms Jimmy Test
             Options design (not the older TabControl layout): a ListBox of category names next
             to a single content host; selecting a category swaps CategoryHost's Child and gives
             it its own AccessibleName so JAWS/NVDA announce the category, not a re-announced
             dialog title. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Order matches the baseline's own _categoryListBox: Basic, General, Receive /
                 Auto Reply, Transmit, Hotkeys, Advanced UI, Wanted Calls, Spot Watch, Sounds,
                 Radio, Decode Engine, Decode, Frequencies, Notifications, Logbook Sync, Lookup
                 Data, Appearance. Categories not yet built (Basic, Wanted Calls, Spot Watch,
                 Frequencies, Notifications, Logbook Sync, Lookup Data, Appearance) are omitted
                 from this list rather than shown broken; see the migration report. -->
            <ListBox x:Name="CategoryList" Grid.Column="0" AutomationProperties.Name="Options categories"
                     SelectionChanged="CategoryList_SelectionChanged">
                <ListBoxItem Content="General"/>
                <ListBoxItem Content="Receive / Auto Reply"/>
                <ListBoxItem Content="Transmit"/>
                <ListBoxItem Content="Hotkeys"/>
                <ListBoxItem Content="Advanced UI"/>
                <ListBoxItem Content="Sounds"/>
                <ListBoxItem Content="Radio"/>
                <ListBoxItem Content="Decode Engine"/>
                <ListBoxItem Content="Decode"/>
            </ListBox>

            <Border x:Name="CategoryHost" Grid.Column="2" BorderThickness="0"/>
        </Grid>
    </DockPanel>
</Window>
