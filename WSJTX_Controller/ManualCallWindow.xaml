<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WSJTX_Controller.ManualCallWindow"
        Title="Call Callsign"
        Width="300" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="12">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Callsign:" VerticalAlignment="Center" Width="60"/>
            <TextBox x:Name="CallTextBox" Width="168" AutomationProperties.Name="Callsign"
                     CharacterCasing="Upper"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
