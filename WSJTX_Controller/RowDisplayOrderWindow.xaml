<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WSJTX_Controller"
        x:Class="WSJTX_Controller.RowDisplayOrderWindow"
        Title="Row Display Order"
        Width="520" Height="440" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OkButton" Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>

        <TabControl x:Name="Tabs">
            <TabItem Header="Stations Available" AutomationProperties.Name="Stations Available">
                <local:CheckableOrderedListBox x:Name="CallWaitingList" Margin="10"/>
            </TabItem>
            <TabItem Header="Raw Decodes" AutomationProperties.Name="Raw Decodes">
                <local:CheckableOrderedListBox x:Name="RawDecodeList" Margin="10"/>
            </TabItem>
            <TabItem Header="Spot Watch" AutomationProperties.Name="Spot Watch">
                <local:CheckableOrderedListBox x:Name="SpotWatchList" Margin="10"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
