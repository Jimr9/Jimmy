<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WSJTX_Controller.MainWindow"
        Title="Jimmy Test"
        Width="560" Height="520" MinWidth="480" MinHeight="440">
    <!-- Structure mirrors the WinForms baseline main window top-to-bottom: lists, then the
         operating-mode row, then status, then the Options/Row Order/Sort Order/Logbook button
         stack, then the version line. Most of the WinForms Controller's OTHER declared fields
         (reply/filter checkboxes, except list, hold/freq/period/timeout, band combo, the CQ-type
         checkboxes) are never actually shown on the main window in baseline: they're
         reparented into Options (or, for Call CQ, a separate dialog) at runtime and are
         permanently invisible here. See OptionsWindow.xaml / CallCqWindow.xaml for their real
         home. -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="90"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: lists: call queue (or advanced Tx1/Tx2/Raw/Spot Watch) left/wide, logged right/narrow -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="30*"/>
            </Grid.ColumnDefinitions>

            <!-- Simple layout: one call queue list. Advanced layout swaps this region for
                 Tx1/Tx2/Raw (and Spot Watch, which also needs Advanced Call Layout on): see
                 MainWindow.xaml.cs ApplyLayoutMode(). -->
            <DockPanel x:Name="SimpleCallPanel" Grid.Column="0">
                <TextBox x:Name="CallQueueHeader" Text="Stations calling:" DockPanel.Dock="Top" Margin="0,0,0,4"
                         IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         AutomationProperties.Name="Pending calls count"/>
                <ListBox x:Name="CallQueueList" AutomationProperties.Name="Stations calling"
                         PreviewKeyDown="CallQueueList_PreviewKeyDown"/>
            </DockPanel>

            <Grid x:Name="AdvancedCallPanel" Grid.Column="0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel x:Name="Tx1Panel" Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock x:Name="Tx1Header" Text="TX1 available stations:" DockPanel.Dock="Top" Margin="0,0,0,2"/>
                    <ListBox x:Name="Tx1List" AutomationProperties.Name="TX1 available stations"
                             PreviewKeyDown="AdvancedList_PreviewKeyDown"/>
                </DockPanel>
                <DockPanel x:Name="Tx2Panel" Grid.Row="1" Margin="0,0,0,4">
                    <TextBlock x:Name="Tx2Header" Text="TX2 available stations:" DockPanel.Dock="Top" Margin="0,0,0,2"/>
                    <ListBox x:Name="Tx2List" AutomationProperties.Name="TX2 available stations"
                             PreviewKeyDown="AdvancedList_PreviewKeyDown"/>
                </DockPanel>
                <DockPanel x:Name="RawPanel" Grid.Row="2" Margin="0,0,0,4">
                    <TextBlock x:Name="RawHeader" Text="Raw decodes:" DockPanel.Dock="Top" Margin="0,0,0,2"/>
                    <ListBox x:Name="RawList" AutomationProperties.Name="Raw decodes"
                             PreviewKeyDown="AdvancedList_PreviewKeyDown"/>
                </DockPanel>
                <DockPanel x:Name="SpotWatchPanel" Grid.Row="3">
                    <TextBlock x:Name="SpotWatchHeader" Text="Spot Watch:" DockPanel.Dock="Top" Margin="0,0,0,2"/>
                    <ListBox x:Name="SpotWatchList" AutomationProperties.Name="Spot Watch"/>
                </DockPanel>
            </Grid>

            <DockPanel Grid.Column="2">
                <TextBox x:Name="LoggedHeader" Text="Auto-logged:" DockPanel.Dock="Top" Margin="0,0,0,4"
                         IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         AutomationProperties.Name="Auto-logged count"/>
                <ListBox x:Name="LoggedList" AutomationProperties.Name="Auto-logged calls"/>
            </DockPanel>
        </Grid>

        <!-- Row 1: operating mode -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <Button x:Name="HelpButton" Content="Help" Width="70" Height="26" DockPanel.Dock="Right"
                    AutomationProperties.Name="Help" Click="HelpButton_Click"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="ListenRadio" Content="'_Listen for calls' mode" GroupName="Mode" Margin="0,0,16,0"
                             AutomationProperties.Name="Listen for calls mode" Checked="ListenRadio_Checked"/>
                <RadioButton x:Name="CqRadio" Content="'Call C_Q' mode" GroupName="Mode" Margin="0,0,16,0"
                             AutomationProperties.Name="Call CQ mode" Checked="CqRadio_Checked"/>
                <Button x:Name="CallCqOptionsButton" Content="Call CQ _options..." Padding="8,4"
                        AutomationProperties.Name="Call CQ options" Click="CallCqOptionsButton_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Row 2: status -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Status:" FontWeight="Bold" Margin="0,0,0,2"/>
            <TextBlock x:Name="StatusAnnounceText" Text="Ready." FontWeight="Bold" TextWrapping="Wrap"
                       Background="DarkRed" Foreground="White" Padding="4"
                       AutomationProperties.Name="Ready."
                       AutomationProperties.LiveSetting="Assertive"/>
            <TextBox x:Name="StatusReviewBox" Margin="0,4,0,0" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="60"
                     VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Status detail"/>
        </StackPanel>

        <!-- Row 3: main button stack, matching the baseline's vertical Options/Row Order/
             Sort Order/Logbook button column -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <Button x:Name="OptionsButton" Content="Options..." Height="26" Margin="0,0,0,4"
                    AutomationProperties.Name="Options" Click="OptionsButton_Click"/>
            <Button x:Name="RowOrderButton" Content="Row Display Order..." Height="26" Margin="0,0,0,4"
                    AutomationProperties.Name="Row Display Order" Click="RowOrderButton_Click"/>
            <Button x:Name="SortOrderButton" Content="Stations Available Sort Order..." Height="26" Margin="0,0,0,4"
                    AutomationProperties.Name="Stations Available Sort Order" Click="SortOrderButton_Click"/>
            <Button x:Name="LogbookButton" Content="Logbook" Height="26"
                    AutomationProperties.Name="Logbook" Click="LogbookButton_Click"/>
        </StackPanel>

        <!-- Row 4: version / update-check line -->
        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <TextBlock x:Name="VerLabel" MouseDown="VerLabel_MouseDown" Margin="0,0,16,0"/>
            <TextBlock x:Name="VerLabel2" Text="Check for update" Foreground="DarkBlue" TextDecorations="Underline"
                       Cursor="Hand" MouseLeftButtonUp="VerLabel2_Click"/>
        </StackPanel>
    </Grid>
</Window>
