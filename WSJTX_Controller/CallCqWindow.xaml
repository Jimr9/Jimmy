<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WSJTX_Controller.CallCqWindow"
        Title="Call CQ"
        Width="440" SizeToContent="Height" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        ResizeMode="NoResize">
    <StackPanel Margin="12">
        <GroupBox Header="Call:" AutomationProperties.Name="What kind of CQ to call">
            <StackPanel Margin="6">
                <CheckBox x:Name="NonDirCqCheck" Content="Call 'CQ' (non-directed)" Margin="0,4"/>
                <CheckBox x:Name="CqDxCheck" Content="Call 'CQ DX'" Margin="0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <CheckBox x:Name="DirCqCheck" Content="Call CQ directed to:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="DirectedBox" Width="110" AutomationProperties.Name="Directed CQ codes, separated by spaces"/>
                    <TextBlock Text="(separate by spaces)" Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <TextBlock Text="Directed CQ code to use:" Margin="0,10,0,4"/>
        <ComboBox x:Name="DirectedComboBox" AutomationProperties.Name="Directed CQ code to use"/>

        <TextBlock Text="Transmit slot:" Margin="0,10,0,4"/>
        <ComboBox x:Name="SlotComboBox" AutomationProperties.Name="Which transmit slot to use">
            <ComboBoxItem Content="TX1 (Even)"/>
            <ComboBoxItem Content="TX2 (Odd)"/>
        </ComboBox>

        <Button x:Name="FindSlotButton" Content="Find open slot" HorizontalAlignment="Left" Margin="0,10,0,0"
                Padding="8,4" Click="FindSlotButton_Click"/>
        <TextBlock x:Name="SlotStatusLabel" Margin="0,6,0,0" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
